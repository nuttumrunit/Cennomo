# Public HTTP server
PORT=4185
HOST=0.0.0.0
PUBLIC_ORIGIN=http://127.0.0.1:4185
DOMAIN=cennomo.example.com

# Solana launch configuration.
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
CENNOMO_TOKEN_MINT=
CENNOMO_TOKEN_DECIMALS=6
CENNOMO_BURN_AMOUNT=10000
PUMPFUN_URL=https://pump.fun/

# A long random value shared only by server and worker.
CENNOMO_WORKER_TOKEN=change-me-before-public-deployment
CENNOMO_WORKER_ID=worker-01
CENNOMO_WORKER_INTERVAL_MS=60000

# Required before public administration. Use long random values and keep them server-side.
CENNOMO_ADMIN_TOKEN=
CENNOMO_ENCRYPTION_KEY=
CENNOMO_GATEWAY_API_KEYS=
CENNOMO_WEB_ORIGINS=https://www.example.com,https://example.com

# Paid Gateway settlement activates only when all values are real.
CENNOMO_TREASURY_ADDRESS=AoFRLLN3GjGcz5BxNuRTqLNDYSgrbhmYggUNotbDAHNF
CENNOMO_DEFAULT_CALL_FEE_LAMPORTS=0

# Optional credentials unlock account-scoped/write skills. Public reference
# inspection remains available without them; never expose these in the browser.
NOTION_API_TOKEN=
BLENDER_PATH=
SHOPIFY_ADMIN_TOKEN=
STRIPE_TEST_SECRET_KEY=
LINEAR_API_KEY=
FIGMA_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
